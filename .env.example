DOCKER_POSTGRES_IMAGE_TAG=17-alpine
DOCKER_GUACAMOLE_IMAGE_TAG=1.6.0

POSTGRES_DB=guacamole
POSTGRES_USER=guacamole
POSTGRES_PASSWORD=

DNS_SEARCH_DOMAIN=contoso.local
DNS_SERVER_PRIMARY=
DNS_SERVER_SECONDARY=

POSTGRES_PORT=5432
POSTGRES_HOST_BIND=127.0.0.1

GUACAMOLE_WEB_PORT=8080
GUACAMOLE_WEB_HOST_BIND=127.0.0.1

GUACAMOLE_UID=1000

TOTP_ENABLE=false
TOTP_ISSUER=Apache Guacamole

LDAP_HOSTNAME=dc-1.contoso.local
LDAP_PORT=636
LDAP_ENCRYPTION_METHOD=ssl

LDAP_SEARCH_BIND_DN=CN=Guacamole LDAP,OU=Users,DC=contoso,DC=local
LDAP_SEARCH_BIND_PASSWORD=

LDAP_USER_BASE_DN=OU=Users,DC=contoso,DC=local
LDAP_USERNAME_ATTRIBUTE=sAMAccountName

LDAP_USER_SEARCH_FILTER=(&(objectClass=user)(memberOf=CN=Guacamole Users,OU=Groups,DC=contoso,DC=local))

LDAP_GROUP_BASE_DN=OU=Groups,DC=contoso,DC=local
LDAP_GROUP_MEMBER_ATTRIBUTE=member
LDAP_GROUP_SEARCH_FILTER=(|(cn=Guacamole*))

LDAP_FOLLOW_REFERRALS=false
LDAP_DEREFERENCE_ALIASES=never
LDAP_MAX_SEARCH_RESULTS=1000
